#!/bin/sh
### BEGIN INIT INFO
# Provides:          nginx-proxy-manager
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: nginx-proxy-manager reverse proxy manager
# Description:       GUI-based reverse proxy manager built on Node.js and Nginx
### END INIT INFO

# Author: nginx-proxy-manager <admin@example.com>

NAME=nginx-proxy-manager
DAEMON=/usr/bin/node
DAEMON_ARGS="/usr/lib/nginx-proxy-manager/start.js"
DAEMON_USER=npm
DAEMON_GROUP=npm
WORKDIR=/usr/lib/nginx-proxy-manager
PIDFILE=/var/run/${NAME}.pid
LOGFILE=/var/log/nginx-proxy-manager/${NAME}.log

# Exit if the package is not installed
[ -x "$DAEMON" ] || exit 0

set -e

start() {
    echo "Starting ${NAME}..."
    start-stop-daemon --start --background --make-pidfile \
        --pidfile "${PIDFILE}" \
        --chuid "${DAEMON_USER}:${DAEMON_GROUP}" \
        --chdir "${WORKDIR}" \
        --exec "${DAEMON}" -- ${DAEMON_ARGS} \
        >> "${LOGFILE}" 2>&1
    echo "${NAME} started."
}

stop() {
    echo "Stopping ${NAME}..."
    start-stop-daemon --stop --pidfile "${PIDFILE}" --retry 5
    rm -f "${PIDFILE}"
    echo "${NAME} stopped."
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "${PIDFILE}" ]; then
        PID=$(cat "${PIDFILE}")
        if kill -0 "${PID}" 2>/dev/null; then
            echo "${NAME} is running (PID: ${PID})."
        else
            echo "${NAME} is not running but PID file exists."
            rm -f "${PIDFILE}"
        fi
    else
        echo "${NAME} is not running."
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|force-reload)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|force-reload|status}"
        exit 1
        ;;
esac

exit 0
