[Application]
Path=C:\node\node.exe
AppDirectory=C:\node
DisplayName=Node.js
Description=Node.js - JavaScript runtime
Start=auto

[Parameters]
CommandLineArgs=/etc/node/server.js
AppParameters=/etc/node/server.js

[Environment]
NODE_ENV=production
NODE_PORT=3000
HOME=C:\node

[Paths]
AppRotationTimeout=15000
AppRestartDelay=2500
AppRotateFiles=10
AppRotateByteMapSize=10485760

[Shutdown]
ConsoleCtrlHandler=1
WaitForProcessExit=60000
KillAppTerminate=1
KillProcessTimeout=2000

[Output]
AppStdout=C:\node\logs\stdout.log
AppStderr=C:\node\logs\stderr.log
AppRotateFiles=10
AppRotateByteMapSize=10485760
AppRotateTimeout=15000

[Info]
ServiceName=node
ServiceDisplayName=Node.js
ServiceDescription=Node.js - JavaScript runtime
ServiceType=own_process
StartType=auto_start
ErrorControl=normal