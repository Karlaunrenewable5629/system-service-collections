[Unit]
Description=Node.js - JavaScript runtime
Documentation=https://nodejs.org/en/docs/
After=network-online.target remote-fs.target nss-lookup-target
Wants=network-online.target

[Service]
Type=simple
User=node
Group=node
WorkingDirectory=/etc/node
ExecStart=/usr/local/bin/node /etc/node/server.js
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
KillMode=mixed
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/node /run /var/www/node
Environment=NODE_ENV=production NODE_PORT=3000 NODE_DEBUG_PORT=9229

[Install]
WantedBy=multi-user.target