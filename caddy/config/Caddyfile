# Caddy Configuration File
# Global options
{
    admin off
    email admin@example.com
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
    }
}

# Default HTTP server
:80 {
    respond "Caddy is running!" 200
}

