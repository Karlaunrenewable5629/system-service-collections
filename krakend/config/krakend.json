{
  "version": 2,
  "endpoint": [{ "endpoint": "/", "method": "GET", "backend": ["backend"] }],
  "backend": [{ "host": ["http://localhost:8080"], "url_pattern": "/", "method": "GET" }],
  "server": { "port": 8080, "metrics_port": 8081, "read_timeout": "30s", "write_timeout": "30s", "idle_timeout": "120s", "debug": false },
  "logging": { "level": "INFO", "format": "json", "prefix": "krakend" },
  "rate_limiting": { "max_rate": 1000, "rates": [{ "path": "/", "rate": 100 }] },
  "circuit_breaker": { "threshold": 0.5, "timeout": "10s", "interval": "10s" },
  "cache": { "ttl": "10s" },
  "cors": {
    "allow_origins": ["*"],
    "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allow_headers": ["Authorization", "Content-Type"],
    "expose_headers": ["X-Total-Count"],
    "max_age": "12h"
  },
  "jwt_validation": { "enabled": false, "secret": "", "algorithm": "HS256" }
}
