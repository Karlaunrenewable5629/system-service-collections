#!/sbin/openrc-run
# LiteLLM OpenRC init script

name="litellm"
description="LiteLLM - Unified LLM API Proxy"
command="/usr/local/bin/litellm"
command_args="--config /etc/litellm/config.yaml --host 0.0.0.0 --port 4000"
command_user="litellm:litellm"
pidfile="/run/litellm/litellm.pid"
directory="/var/lib/litellm"

depend() {
    need net
    after firewall
    use logger dns
}

start_pre() {
    checkpath -d -m 0755 -o litellm:litellm /run/litellm
    checkpath -d -m 0750 -o litellm:litellm /var/lib/litellm /var/log/litellm
    checkpath -f -m 0640 -o litellm:litellm /etc/litellm/config.yaml
}

stop_post() {
    rm -f /run/litellm/litellm.pid
}