[Unit]
Description=LiteLLM - Unified LLM API Proxy
Documentation=https://docs.litellm.ai/
After=network.target
Wants=network.target

[Service]
Type=exec
User=litellm
Group=litellm
EnvironmentFile=-/etc/litellm/environment
ExecStart=/usr/local/bin/litellm --config /etc/litellm/config.yaml --host 0.0.0.0 --port 4000
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/litellm /var/log/litellm /etc/litellm
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryLimit=4G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=litellm

[Install]
WantedBy=multi-user.target