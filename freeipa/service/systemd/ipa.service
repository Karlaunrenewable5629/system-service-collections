# /etc/systemd/system/ipa.service
#
# FreeIPA Master Service Unit
# ----------------------------
# This unit is shipped with the freeipa-server package on RHEL/CentOS/Fedora
# and acts as a controller that starts/stops all IPA sub-services via ipactl.
#
# Sub-services managed by ipactl:
#   - dirsrv@<REALM>     (389 Directory Server)
#   - krb5kdc            (MIT Kerberos KDC)
#   - kadmin             (Kerberos admin daemon)
#   - named / named-pkcs11 (BIND DNS, if enabled)
#   - httpd              (Apache HTTPD — Web UI & API)
#   - ipa-custodia        (secret distribution)
#   - ipa-otpd           (OTP proxy)
#   - ipa-dnskeysyncd    (DNS key sync, if DNS enabled)
#   - pki-tomcatd@pki-tomcat (Dogtag CA)
#
# Installation:
#   sudo cp ipa.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ipa
#
# NOTE: On systems where freeipa-server was installed via dnf/yum the unit
# file already exists. Copy this file only if it is absent.

[Unit]
Description=Identity, Policy, Audit
Documentation=man:ipactl(8)
Documentation=https://www.freeipa.org/page/Documentation

# Require network to be fully online before starting
After=network-online.target
Wants=network-online.target

# Prevent starting before the system clock is synchronised (important for Kerberos)
After=time-sync.target
Wants=time-sync.target

# If BIND is managed separately, ensure it is up first
# After=named.service

[Service]
Type=oneshot

# Keep the service "active" after the start command exits
RemainAfterExit=yes

# ipactl handles the ordered startup of all IPA sub-services
ExecStart=/usr/sbin/ipactl start
ExecStop=/usr/sbin/ipactl stop
ExecReload=/usr/sbin/ipactl restart

# Allow sufficient time for all sub-services to start (CA can be slow)
TimeoutStartSec=600
TimeoutStopSec=120

# Ensure sub-services are forcibly stopped if ipactl stop fails
KillMode=control-group

# Log output to the journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ipa

[Install]
WantedBy=multi-user.target
