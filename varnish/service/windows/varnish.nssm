[Application]
Path=C:\Program Files\Varnish\varnishd.exe
AppDirectory=C:\Program Files\Varnish
DisplayName=Varnish Cache
Description=Varnish Cache - high performance HTTP accelerator
Start=auto

[Parameters]
CommandLineArgs=-a :6081 -b 127.0.0.1:8080 -f /etc/varnish/default.vcl -S /etc/varnish/secret -s malloc,256m
AppParameters=-a :6081 -b 127.0.0.1:8080 -f /etc/varnish/default.vcl -S /etc/varnish/secret -s malloc,256m

[Environment]
Home=C:\Program Files\Varnish
VARNISH_CONFIG_PATH=/etc/varnish/default.vcl
VARNISH_SECRET_PATH=/etc/varnish/secret

[Paths]
AppRotationTimeout=15000
AppRestartDelay=2500
AppRotateFiles=10
AppRotateByteMapSize=10485760

[Shutdown]
ConsoleCtrlHandler=1
WaitForProcessExit=60000
KillAppTerminate=1
KillProcessTimeout=2000

[Output]
AppStdout=C:\Program Files\Varnish\logs\stdout.log
AppStderr=C:\Program Files\Varnish\logs\stderr.log
AppRotateFiles=10
AppRotateByteMapSize=10485760
AppRotateTimeout=15000

[Info]
ServiceName=varnish
ServiceDisplayName=Varnish Cache
ServiceDescription=Varnish Cache - high performance HTTP accelerator
ServiceType=own_process
StartType=auto_start
ErrorControl=normal
