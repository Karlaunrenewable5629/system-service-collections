[Unit]
Description=Authentik Identity Provider - Worker
Documentation=https://docs.goauthentik.io/
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple

# User / Group
User=authentik
Group=authentik

# Working and state directories
WorkingDirectory=/opt/authentik
RuntimeDirectory=authentik-worker
RuntimeDirectoryMode=0750

# Environment
EnvironmentFile=/etc/authentik/.env

# Main process: authentik background worker (Celery)
ExecStart=/opt/authentik/venv/bin/python -m authentik.manage worker

# Graceful stop: allow in-progress tasks to finish
TimeoutStopSec=90
KillMode=mixed
KillSignal=SIGTERM

# Restart behaviour
Restart=on-failure
RestartSec=5s
StartLimitInterval=120s
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=authentik-worker

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/authentik /var/log/authentik
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
