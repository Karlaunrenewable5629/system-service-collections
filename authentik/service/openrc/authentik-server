#!/sbin/openrc-run
# =============================================================================
# OpenRC init script for Authentik Identity Provider - Server
# =============================================================================
# Install: sudo cp authentik-server /etc/init.d/
#          sudo chmod +x /etc/init.d/authentik-server
#          sudo rc-update add authentik-server default
#          sudo rc-service authentik-server start

description="Authentik Identity Provider - Server"
extra_commands="checkconfig"
extra_started_commands="reload"

: "${AUTHENTIK_USER:=authentik}"
: "${AUTHENTIK_GROUP:=authentik}"
: "${INSTALL_DIR:=/opt/authentik}"
: "${CONFIG_FILE:=/etc/authentik/.env}"
: "${LOG_DIR:=/var/log/authentik}"
: "${PIDFILE:=/run/authentik/authentik-server.pid}"

name="authentik-server"
command="${INSTALL_DIR}/venv/bin/python"
command_args="-m authentik.manage server"
command_user="${AUTHENTIK_USER}:${AUTHENTIK_GROUP}"
command_background="yes"
pidfile="${PIDFILE}"
output_log="${LOG_DIR}/server.log"
error_log="${LOG_DIR}/server-error.log"
start_stop_daemon_args="--env-file ${CONFIG_FILE} --chdir ${INSTALL_DIR}"

depend() {
    need net
    need postgresql
    need redis
    after localmount logger
}

checkconfig() {
    if [ ! -f "${CONFIG_FILE}" ]; then
        eerror "Configuration file not found: ${CONFIG_FILE}"
        return 1
    fi
    if [ ! -f "${INSTALL_DIR}/venv/bin/python" ]; then
        eerror "Authentik virtual environment not found: ${INSTALL_DIR}/venv"
        return 1
    fi
    return 0
}

start_pre() {
    checkconfig || return 1
    checkpath --directory --owner "${AUTHENTIK_USER}:${AUTHENTIK_GROUP}" --mode 0750 "$(dirname "${PIDFILE}")"
    checkpath --directory --owner "${AUTHENTIK_USER}:${AUTHENTIK_GROUP}" --mode 0750 "${LOG_DIR}"
}

reload() {
    ebegin "Reloading ${name} configuration"
    start-stop-daemon --signal HUP --pidfile "${PIDFILE}"
    eend $?
}
