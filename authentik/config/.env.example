# =============================================================================
# Authentik Environment Configuration
# =============================================================================
# Copy this file to /etc/authentik/.env (Linux) or C:\authentik\.env (Windows)
# and customize values before starting the service.
#
# Reference: https://docs.goauthentik.io/docs/installation/configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------

# REQUIRED: Django secret key. Generate with: openssl rand -base64 60
# Do NOT change this after initial deployment — it will invalidate all sessions.
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-50-chars

# Log level: trace, debug, info, warning, error
AUTHENTIK_LOG_LEVEL=info

# Disable anonymous error reporting to goauthentik.io
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Disable startup analytics
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true

# Disable automatic update checks (recommended for air-gapped environments)
AUTHENTIK_DISABLE_UPDATE_CHECK=false

# Enable GDPR compliance mode (masks IP addresses in logs)
AUTHENTIK_GDPR_COMPLIANCE=true

# Allow superusers to impersonate users
AUTHENTIK_IMPERSONATION=true

# Default token length
AUTHENTIK_DEFAULT_TOKEN_LENGTH=60

# Avatar sources (comma-separated): gravatar, initials, none
AUTHENTIK_AVATARS=gravatar,initials

# -----------------------------------------------------------------------------
# HTTP / Listen Settings
# -----------------------------------------------------------------------------

# HTTP listen address
AUTHENTIK_LISTEN__HTTP=0.0.0.0:9000

# HTTPS listen address
AUTHENTIK_LISTEN__HTTPS=0.0.0.0:9443

# LDAP listen address (used by embedded LDAP outpost)
AUTHENTIK_LISTEN__LDAP=0.0.0.0:3389

# LDAPS listen address
AUTHENTIK_LISTEN__LDAPS=0.0.0.0:6636

# Prometheus metrics endpoint
AUTHENTIK_LISTEN__METRICS=0.0.0.0:9300

# Debug endpoint (disable or restrict in production)
# AUTHENTIK_LISTEN__DEBUG=127.0.0.1:9900

# -----------------------------------------------------------------------------
# PostgreSQL Settings
# -----------------------------------------------------------------------------

AUTHENTIK_POSTGRESQL__HOST=localhost
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=change-me-strong-db-password

# SSL mode: disable, allow, prefer, require, verify-ca, verify-full
AUTHENTIK_POSTGRESQL__SSLMODE=prefer

# Paths to SSL certificates (optional, for verify-ca / verify-full modes)
# AUTHENTIK_POSTGRESQL__SSLROOTCERT=/etc/authentik/ssl/ca.crt
# AUTHENTIK_POSTGRESQL__SSLCERT=/etc/authentik/ssl/client.crt
# AUTHENTIK_POSTGRESQL__SSLKEY=/etc/authentik/ssl/client.key

# -----------------------------------------------------------------------------
# Redis Settings
# -----------------------------------------------------------------------------

AUTHENTIK_REDIS__HOST=localhost
AUTHENTIK_REDIS__PORT=6379
AUTHENTIK_REDIS__DB=0

# Redis password (leave empty if AUTH is not configured)
AUTHENTIK_REDIS__PASSWORD=

# Enable TLS for Redis
AUTHENTIK_REDIS__TLS=false
# AUTHENTIK_REDIS__TLS_REQS=none

# -----------------------------------------------------------------------------
# Email / SMTP Settings
# -----------------------------------------------------------------------------

AUTHENTIK_EMAIL__HOST=localhost
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=authentik@example.com

# -----------------------------------------------------------------------------
# Worker Settings
# -----------------------------------------------------------------------------

# Number of concurrent worker tasks
AUTHENTIK_WORKER__CONCURRENCY=2

# -----------------------------------------------------------------------------
# Media / File Storage Settings
# -----------------------------------------------------------------------------

# Storage backend: file or s3
AUTHENTIK_MEDIA__BACKEND=file

# Path for local media storage (used when backend=file)
AUTHENTIK_MEDIA__FILE__PATH=/var/lib/authentik/media

# S3 settings (used when backend=s3)
# AUTHENTIK_MEDIA__S3__ACCESS_KEY=
# AUTHENTIK_MEDIA__S3__SECRET_KEY=
# AUTHENTIK_MEDIA__S3__BUCKET_NAME=authentik-media
# AUTHENTIK_MEDIA__S3__REGION=us-east-1
# AUTHENTIK_MEDIA__S3__ENDPOINT=https://s3.amazonaws.com

# -----------------------------------------------------------------------------
# Bootstrap Settings (used only on first run to create initial admin)
# -----------------------------------------------------------------------------

# Initial password for the akadmin user (leave empty to auto-generate)
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Initial API token for akadmin (leave empty to auto-generate)
AUTHENTIK_BOOTSTRAP_TOKEN=

# Email for the bootstrap akadmin user
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
