@echo off
REM MicroK8s Windows Note
REM MicroK8s does not run natively on Windows.
REM Use Multipass, WSL2, or a Linux VM.
REM
REM Option 1: Multipass VM (recommended by Canonical)
REM   winget install Canonical.Multipass
REM   multipass launch --name microk8s-vm --mem 4G --disk 20G
REM   multipass exec microk8s-vm -- sudo snap install microk8s --classic
REM   multipass exec microk8s-vm -- sudo microk8s status --wait-ready
REM   multipass exec microk8s-vm -- microk8s config > %USERPROFILE%\.kube\config
REM
REM Option 2: WSL2 with Ubuntu
REM   wsl --install -d Ubuntu
REM   sudo snap install microk8s --classic
REM
REM Option 3: MicroK8s Windows Installer (experimental)
REM   https://microk8s.io/docs/install-windows

echo MicroK8s does not run natively on Windows.
echo.
echo Recommended options:
echo   1. Multipass: winget install Canonical.Multipass
echo   2. WSL2:      wsl --install -d Ubuntu
echo   3. See:       https://microk8s.io/docs/install-windows
