#!/bin/sh
### BEGIN INIT INFO
# Provides:          nginx
# Required-Start:    $network $remote_fs $syslog
# Required-Stop:     $network $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: nginx - high performance HTTP server and reverse proxy
# Description:       Starts/stops the nginx daemon
### END INIT INFO

NAME=nginx
DAEMON=/usr/sbin/nginx
DAEMON_OPTS="-g 'daemon on; master_process on;'"
PIDFILE=/run/nginx.pid
CONFIG=/etc/nginx/nginx.conf
NGINX_USER=nginx
NGINX_GROUP=nginx

set -e

. /lib/lsb/init-functions

test -x $DAEMON || exit 0
test -f $CONFIG || exit 0

case "$1" in
  start)
    echo -n "Starting $NAME: "
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
      echo "$NAME already running."
      exit 0
    fi
    $DAEMON $DAEMON_OPTS
    echo "$NAME."
    ;;
  stop)
    echo -n "Stopping $NAME: "
    if [ ! -f "$PIDFILE" ]; then
      echo "$NAME not running."
      exit 0
    fi
    kill -QUIT $(cat "$PIDFILE")
    rm -f "$PIDFILE"
    echo "$NAME."
    ;;
  restart|force-reload)
    echo -n "Restarting $NAME: "
    $0 stop
    sleep 1
    $DAEMON $DAEMON_OPTS
    echo "$NAME."
    ;;
  reload)
    echo -n "Reloading $NAME: "
    if [ ! -f "$PIDFILE" ]; then
      echo "$NAME not running."
      exit 0
    fi
    kill -HUP $(cat "$PIDFILE")
    echo "$NAME."
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 $(cat "$PIDFILE") 2>/dev/null; then
      echo "$NAME is running (PID $(cat "$PIDFILE"))."
    else
      echo "$NAME is not running."
      exit 1
    fi
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|force-reload|reload|status}"
    exit 1
    ;;
esac

exit 0